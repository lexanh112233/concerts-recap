# ============================================================================
# Các biến môi trường của Concert Journal.
#
# - Chạy trên máy: sao chép file này thành .env.local rồi điền giá trị.
# - Chạy trên Vercel: KHÔNG dùng file này, điền cùng tên biến ở
#   Project → Settings → Environment Variables (xem README.md).
# - Đừng bao giờ commit file .env.local hay dán giá trị thật vào issue/ảnh chụp màn hình.
# - Đổi biến xong phải khởi động lại (hoặc Redeploy trên Vercel) thì mới có hiệu lực.
# ============================================================================

# ---------------------------- BẮT BUỘC ----------------------------

# Chuỗi kết nối MongoDB (lấy ở MongoDB Atlas → Connect → Drivers). PHẢI có tên database sau dấu "/" ngay trước dấu "?", ví dụ:
# mongodb+srv://tenuser:matkhau@cluster0.abcde.mongodb.net/nhat-ky?retryWrites=true&w=majority
MONGODB_URI=

# Mật khẩu vào trang quản trị (/admin). Đặt dài (từ 12 ký tự, ví dụ một cụm từ dài) và đừng dùng lại mật khẩu ở nơi khác.
# Không đặt biến này thì trang quản trị bị tắt hoàn toàn (không ai vào được, kể cả bạn).
ADMIN_PASSWORD=

# ---------------------------- TUỲ CHỌN ----------------------------

# Tên của bạn: hiện ở logo, tiêu đề tab và bìa sổ quản trị, ghép thành "<tên> đi show" (vd. Linh → "Linh đi show").
# Bỏ trống thì dùng "Mình" ("Mình đi show"). Đây là biến "NEXT_PUBLIC_": được nhúng lúc build nên đổi xong phải chạy lại/deploy lại.
NEXT_PUBLIC_YOUR_NAME=

# ------------- ẢNH & VIDEO (Cloudflare R2): điền đủ 5 biến hoặc bỏ trống cả 5 -------------
# Bỏ trống thì trang vẫn chạy, viết nhật ký được, chỉ là chưa tải ảnh/video lên được (và xoá sự kiện sẽ không xoá được file trên R2).
# API token R2 cần quyền "Object Read & Write" (ghi để tải lên, xoá để dọn file khi xoá một sự kiện), nên giới hạn cho đúng một bucket.

# Account ID: dãy chữ-số dài ở trang R2 (Cloudflare → R2 Object Storage, cột bên phải)
R2_ACCOUNT_ID=
# Access Key ID và Secret Access Key: hiện ra MỘT LẦN duy nhất khi tạo API token (R2 → Manage API tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Tên bucket bạn đã tạo
R2_BUCKET=
# Địa chỉ công khai của bucket (R2 → bucket → Settings → Public Development URL, hoặc tên miền riêng), KHÔNG có dấu "/" ở cuối. Ví dụ:
# R2_PUBLIC_URL=https://pub-0123456789abcdef.r2.dev
# Đây cũng là nơi DUY NHẤT ảnh/video được phép hiển thị (chặn ảnh từ địa chỉ lạ).
R2_PUBLIC_URL=
